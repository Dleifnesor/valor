# OwO *gives the worker a hard hat* appliance/valor-worker.service: the systemd unit for the job worker! ^w^
# It runs engine jobs (builds, verifies, ...) one at a time, as the 'valor' user, in the same tight sandbox as the
# web service *wags tail*
[Unit]
Description=VALOR job worker (runs engine builds one at a time)
Documentation=https://github.com/Dleifnesor/valor
# Start after the network is up UwU
After=network-online.target
Wants=network-online.target

[Service]
# A plain long-running process as valor:valor; the config location; restart 5 s after a crash >w<
Type=simple
User=valor
Group=valor
Environment=VALOR_CONFIG=/etc/valor/config.toml PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/valor/venv/bin/python -m valor.web.cli worker
Restart=on-failure
RestartSec=5
# A build in progress finishes before the worker stops (it stops between jobs).
TimeoutStopSec=45min
# The sandbox (as in valor-web.service): private files, no privilege gain, read-only system except /var/lib/valor,
# no /home, private /tmp and /dev, no kernel/clock/hostname changes, no namespaces/realtime/SUID, normal system calls
# only, no capabilities, unix + IP sockets only OwO
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/valor
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Start at boot ^w^
[Install]
WantedBy=multi-user.target
